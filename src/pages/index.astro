---
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import Faq from '../components/Faq.astro';
import { site, isPlaceholder } from '../data/site';
import { materials } from '../data/materials';
import { areaGroups } from '../data/areas';
import { homeFaqs } from '../data/faqs';

const hasPhone = !isPlaceholder(site.contact.phoneE164);
const reviewLinks = Object.values(site.reviews).filter((r) => r.url);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Quartz, granite and Dekton worktops, templated and fitted in Cheshire"
  description="Supply and fit of quartz, granite and ultra-compact worktops across Cheshire, Manchester, Merseyside and North Wales. The same teams that template and fit for the national kitchen retailers, working direct for you."
  schema={[faqSchema]}
>
  <!-- Hero -->
  <section class="hero">
    <div class="container hero__inner">
      <div class="hero__copy">
        <span class="eyebrow">Lymm, Cheshire</span>
        <h1>Worktops fitted by the people the kitchen retailers use.</h1>
        <p class="lead">
          Quartz, granite and ultra-compact surfaces. Templated, made and installed by the same teams
          that do it every day for the national kitchen brands. Now direct to you.
        </p>
        <div class="hero__actions">
          <a class="btn" href="#enquire">Get a quote</a>
          {hasPhone && (
            <a class="btn btn--ghost" href={`tel:${site.contact.phoneE164}`}>
              Call {site.contact.phoneDisplay}
            </a>
          )}
        </div>
      </div>
      <Placeholder caption="Finished quartz kitchen, one of our own installs" ratio="5 / 4" class="hero__img" />
    </div>
  </section>

  <!-- Why the template matters -->
  <section class="section">
    <div class="container">
      <div class="section__intro">
        <span class="eyebrow">Why us</span>
        <h2>The template is the job. Everything else follows from it.</h2>
        <p class="lead">
          Most bad worktop installs go wrong before the stone is cut. A join in the wrong place, a hob
          cut-out ten millimetres out, a wall that was never square. We template with the same
          equipment and process we use for the retailers, and we do it every working day.
        </p>
      </div>
      <div class="grid grid--3">
        <div class="card fade">
          <h3>Templated, not measured</h3>
          <p>
            We take a digital template from the fitted units, not a tape measure from a drawing. Out of
            square walls, bowed plaster and unlevel units are captured, not guessed.
          </p>
        </div>
        <div class="card fade">
          <h3>Joins planned before cutting</h3>
          <p>
            We agree where joins and cut-outs go with you at the template visit. No surprises on
            install day.
          </p>
        </div>
        <div class="card fade">
          <h3>One team, start to finish</h3>
          <p>
            The person who templates your kitchen briefs the team that fits it. Two install teams,
            four templaters, one operations manager. No subcontracting the subcontractor.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Materials -->
  <section class="section section--alt">
    <div class="container">
      <div class="section__intro">
        <span class="eyebrow">Materials</span>
        <h2>Three materials. Each one has a weak point.</h2>
        <p class="lead">
          We fit all three and we will tell you which one suits how you cook. The honest comparison is
          on the <a href="/materials">materials page</a>.
        </p>
      </div>
      <div class="grid grid--3">
        {
          materials.map((m) => (
            <a class="mat fade" href={`/materials#${m.slug}`}>
              <Placeholder caption={`${m.name} sample, close up`} ratio="4 / 3" />
              <h3>{m.name}</h3>
              <p class="muted">{m.short}</p>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <!-- Process -->
  <section class="section">
    <div class="container">
      <div class="section__intro">
        <span class="eyebrow">How it works</span>
        <h2>Four steps, and you only need to be in for two of them.</h2>
      </div>
      <ol class="steps">
        <li>
          <h3>Quote</h3>
          <p>Send us the plan or a sketch. We come back with an indicative price and the next survey date.</p>
        </li>
        <li>
          <h3>Template</h3>
          <p>Once the units are fitted and the sink and hob are on site, we template. Around an hour.</p>
        </li>
        <li>
          <h3>Fabrication</h3>
          <p>The stone is cut and polished to the template. Typically {site.leadTimes.templateToInstall}.</p>
        </li>
        <li>
          <h3>Install</h3>
          <p>We fit, join, seal and clean up. Most kitchens are done in half a day.</p>
        </li>
      </ol>
      <p style="margin-top: 2rem"><a href="/how-it-works">What we need from you, and what happens on the day</a></p>
    </div>
  </section>

  <!-- Proof -->
  <section class="section section--teal">
    <div class="container">
      <div class="section__intro">
        <span class="eyebrow">Recent work</span>
        <h2>Our own installs, not stock photos.</h2>
        <p class="lead">Every photo on this site is a kitchen we templated and fitted, shown with the customer's permission.</p>
      </div>
      <div class="grid grid--3">
        <Placeholder caption="Recent install, quartz" class="fade" />
        <Placeholder caption="Recent install, granite" class="fade" />
        <Placeholder caption="Recent install, ultra-compact" class="fade" />
      </div>
      <p style="margin-top: 1.5rem"><a href="/gallery">See the gallery</a></p>

      <div class="reviews">
        <h3>What customers say</h3>
        {
          reviewLinks.length ? (
            <p>
              Read our reviews on{' '}
              {reviewLinks.map((r, i) => (
                <>
                  <a href={r.url} rel="noopener">{r.label}</a>
                  {i < reviewLinks.length - 1 ? ', ' : ''}
                </>
              ))}
              .
            </p>
          ) : (
            <p class="muted">
              [TODO: reviews. We do not publish invented testimonials. Add links to your Google, Checkatrade or
              Trustpilot profiles in src/data/site.ts and this section will link to them.]
            </p>
          )
        }
      </div>
    </div>
  </section>

  <!-- Coverage -->
  <section class="section">
    <div class="container">
      <div class="section__intro">
        <span class="eyebrow">Where we work</span>
        <h2>Cheshire, Greater Manchester, Merseyside and North Wales.</h2>
        <p class="lead">
          Roughly {site.coverageRadiusMiles} miles from Lymm. If you are near the edge, ask. The full list is on the
          <a href="/areas">areas page</a>.
        </p>
      </div>
      <ul class="towns">
        {areaGroups.map((g) => <li><strong>{g.name}:</strong> {g.towns.slice(0, 6).join(', ')} and more</li>)}
      </ul>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--alt">
    <div class="container">
      <Faq items={homeFaqs} />
    </div>
  </section>

  <!-- Enquiry -->
  <section class="section">
    <div class="container">
      <EnquiryForm />
    </div>
  </section>
</Layout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem);
    background: var(--teal-light);
  }
  .hero__inner {
    display: grid;
    gap: 2.5rem;
    align-items: center;
    grid-template-columns: 1fr;
  }
  @media (min-width: 56rem) {
    .hero__inner {
      grid-template-columns: 6fr 5fr;
    }
  }
  .hero__copy {
    max-width: 36rem;
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.75rem;
  }
  .mat {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .mat h3 {
    margin: 1rem 0 0.35rem;
    color: var(--teal-dark);
  }
  .mat:hover h3 {
    text-decoration: underline;
  }
  .reviews {
    margin-top: 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
    max-width: var(--measure);
  }
  .towns {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.5rem;
    max-width: var(--measure);
  }
</style>
