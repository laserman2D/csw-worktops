---
// Self-hosted variable font (OFL licence), bundled by Astro. No Google Fonts request.
import '@fontsource-variable/manrope/wght.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site, isPlaceholder } from '../data/site';
import { allTowns } from '../data/areas';

interface Props {
  /** Page title without the site suffix. */
  title: string;
  description: string;
  /** Extra JSON-LD objects for this page (e.g. FAQPage). */
  schema?: Record<string, unknown>[];
  /** Force noindex for this page (legal skeletons). */
  noindex?: boolean;
}

const { title, description, schema = [], noindex = false } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const fullTitle = `${title} | ${site.titleSuffix}`;
const robots = site.indexable && !noindex ? 'index, follow' : 'noindex, nofollow';

// LocalBusiness schema. Placeholder values are left out rather than published.
const clean = (v: unknown) => (isPlaceholder(v) ? undefined : v);
const localBusiness: Record<string, unknown> = {
  '@context': 'https://schema.org',
  '@type': 'HomeAndConstructionBusiness',
  '@id': new URL('/#business', Astro.site).href,
  name: site.name,
  legalName: site.legal.registeredName,
  url: Astro.site?.href,
  description: site.description,
  telephone: clean(site.contact.phoneE164),
  email: clean(site.contact.email),
  address: {
    '@type': 'PostalAddress',
    streetAddress: clean(site.address.street),
    addressLocality: site.address.locality,
    addressRegion: site.address.region,
    postalCode: clean(site.address.postcode),
    addressCountry: site.address.country,
  },
  areaServed: allTowns.map((t) => ({ '@type': 'City', name: t })),
  priceRange: '£££',
  knowsAbout: ['Quartz worktops', 'Granite worktops', 'Dekton worktops', 'Worktop templating', 'Worktop installation'],
};
if (site.contact.openingHours) {
  localBusiness.openingHoursSpecification = site.contact.openingHours.map((h) => ({
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: h.days,
    opens: h.opens,
    closes: h.closes,
  }));
}
const sameAs = [site.reviews.google.url, site.social.instagram, site.social.facebook].filter(Boolean);
if (sameAs.length) localBusiness.sameAs = sameAs;

const jsonLd = [localBusiness, ...schema];
---

<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical.href} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="theme-color" content="#2E7D7B" />
    <script is:inline>document.documentElement.classList.add('has-js');</script>
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.titleSuffix} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:locale" content="en_GB" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {
      site.cloudflareAnalyticsToken && (
        <script
          is:inline
          defer
          src="https://static.cloudflareinsights.com/beacon.min.js"
          data-cf-beacon={JSON.stringify({ token: site.cloudflareAnalyticsToken })}
        />
      )
    }
    <script>
      // Subtle fade-in on scroll. No-op if reduced motion is set (CSS handles that).
      const els = document.querySelectorAll('.fade');
      if ('IntersectionObserver' in window && els.length) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (e.isIntersecting) {
                e.target.classList.add('is-visible');
                io.unobserve(e.target);
              }
            }
          },
          { rootMargin: '0px 0px -5% 0px' },
        );
        els.forEach((el) => io.observe(el));
      } else {
        els.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
