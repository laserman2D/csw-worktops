---
/**
 * A real photograph with an optional credit. Used for supplier imagery so it
 * is never mistaken for our own work. Falls back to a labelled placeholder
 * when no image is supplied.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Placeholder from './Placeholder.astro';

interface Props {
  image?: ImageMetadata;
  alt: string;
  /** Shown bottom-left over the photo, e.g. "Vadara Aurum. Supplier photo." */
  credit?: string;
  /** CSS aspect ratio, e.g. "4 / 3". Omit to let the parent size it. */
  ratio?: string;
  sizes?: string;
  widths?: number[];
  loading?: 'lazy' | 'eager';
  class?: string;
  /** Placeholder caption when no image. */
  caption?: string;
}
const {
  image,
  alt,
  credit,
  ratio,
  sizes = '(min-width: 60rem) 50vw, 100vw',
  widths = [480, 800, 1200, 1600],
  loading = 'lazy',
  class: cls = '',
  caption = alt,
} = Astro.props;
---

{
  image ? (
    <figure class:list={['photo', cls]} style={ratio ? `aspect-ratio: ${ratio};` : undefined}>
      <Image src={image} alt={alt} widths={widths} sizes={sizes} loading={loading} decoding="async" class="photo__img" />
      {credit && <figcaption class="photo__credit">{credit}</figcaption>}
    </figure>
  ) : (
    <Placeholder caption={caption} ratio={ratio ?? '4 / 3'} class={cls} />
  )
}

<style>
  .photo {
    position: relative;
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    width: 100%;
    background: var(--stone-100);
  }
  .photo__img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .photo__credit {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    font-size: 0.7rem;
    letter-spacing: 0.04em;
    background: rgba(255, 255, 255, 0.85);
    color: var(--text);
    padding: 0.25rem 0.5rem;
    border-radius: 4px;
  }
</style>
