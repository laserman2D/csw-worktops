---
import { site, isPlaceholder } from '../data/site';

const nav = [
  { href: '/colours', label: 'Colours' },
  { href: '/materials', label: 'Materials' },
  { href: '/how-it-works', label: 'How it works' },
  { href: '/gallery', label: 'Gallery' },
  { href: '/pricing', label: 'Pricing' },
  { href: '/areas', label: 'Areas' },
  { href: '/about', label: 'About' },
  { href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const hasPhone = !isPlaceholder(site.contact.phoneE164);
---

<header class="site-header">
  <div class="container container--wide site-header__inner">
    <a class="brand" href="/">
      <span class="brand__name">{site.name}</span>
      <span class="brand__sub">Worktops</span>
    </a>

    <button class="nav-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="nav-toggle__bars" aria-hidden="true"></span>
      <span>Menu</span>
    </button>

    <nav id="site-nav" class="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={path === item.href ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        <li class="site-nav__cta">
          {
            hasPhone ? (
              <a class="btn btn--ghost" href={`tel:${site.contact.phoneE164}`}>
                {site.contact.phoneDisplay}
              </a>
            ) : null
          }
          <a class="btn" href="/contact#enquire">Get a quote</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: #fff;
    border-bottom: 1px solid var(--stone-100);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    min-height: 5rem;
  }
  .brand {
    display: inline-flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--teal-dark);
    line-height: 1;
  }
  .brand__name {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  .brand__sub {
    font-size: 0.7rem;
    font-weight: 400;
    color: var(--muted);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    margin-top: 0.3rem;
  }
  .nav-toggle {
    display: none;
    align-items: center;
    gap: 0.5rem;
    font: inherit;
    font-weight: 700;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.5rem 0.9rem;
    min-height: 2.75rem;
    color: var(--text);
    cursor: pointer;
  }
  .nav-toggle__bars {
    width: 1.1rem;
    height: 2px;
    background: currentColor;
    box-shadow: 0 -5px 0 currentColor, 0 5px 0 currentColor;
  }
  .site-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    align-items: center;
    gap: 0.25rem 1.6rem;
    flex-wrap: wrap;
  }
  .site-nav a:not(.btn) {
    text-decoration: none;
    color: var(--text);
    font-size: 1.0625rem;
    padding: 0.5rem 0;
    display: inline-block;
    border-bottom: 2px solid transparent;
  }
  .site-nav a:not(.btn):hover,
  .site-nav a[aria-current='page'] {
    border-bottom-color: var(--teal);
    color: var(--teal-dark);
  }
  .site-nav__cta {
    display: flex;
    gap: 0.5rem;
    margin-left: 0.5rem;
  }
  .site-nav__cta .btn {
    min-height: 2.75rem;
    padding: 0.45rem 1.1rem;
    font-size: 0.975rem;
  }
  @media (max-width: 68rem) {
    .nav-toggle {
      display: inline-flex;
    }
    .site-nav {
      display: none;
      position: absolute;
      left: 0;
      right: 0;
      top: 100%;
      background: #fff;
      border-bottom: 1px solid var(--border);
      box-shadow: var(--shadow);
    }
    .site-nav.is-open {
      display: block;
    }
    .site-nav ul {
      flex-direction: column;
      align-items: stretch;
      padding: 0.5rem var(--gutter) 1.25rem;
      gap: 0;
    }
    .site-nav a:not(.btn) {
      display: block;
      padding: 0.9rem 0;
      border-bottom: 1px solid var(--stone-100);
      font-size: 1.125rem;
    }
    .site-nav a[aria-current='page'] {
      border-bottom-color: var(--stone-100);
    }
    .site-nav__cta {
      flex-direction: column;
      padding-top: 1rem;
      margin-left: 0;
    }
    .site-nav__cta .btn {
      width: 100%;
      min-height: 3.25rem;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('site-nav');
  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const open = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(open));
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && nav.classList.contains('is-open')) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
        toggle.focus();
      }
    });
  }
</script>
