---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import Placeholder from '../components/Placeholder.astro';
import Photo from '../components/Photo.astro';
import EnquiryForm from '../components/EnquiryForm.astro';
import { vadaraImage } from '../lib/vadaraImages';
import Faq from '../components/Faq.astro';
import { site, isPlaceholder } from '../data/site';
import { materials, comparisonRows, ratingWords } from '../data/materials';
import { swatches } from '../data/swatches';
import { gallery, materialLabels } from '../data/gallery';
import { areaGroups } from '../data/areas';
import { homeFaqs } from '../data/faqs';

const hasPhone = !isPlaceholder(site.contact.phoneE164);
const reviewLinks = Object.values(site.reviews).filter((r) => r.url);
const recent = gallery.filter((g) => g.permission).slice(0, 4);
const compareRows = comparisonRows.filter((r) => ['heat', 'stain', 'chip', 'repair', 'consistency'].includes(r.key));

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: homeFaqs.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
---

<Layout
  title="Quartz, granite and Dekton worktops, templated and fitted in Cheshire"
  description="Supply and fit of quartz, granite and ultra-compact worktops across Cheshire, Manchester, Merseyside and North Wales. The same teams that template and fit for the national kitchen retailers, working direct for you."
  schema={[faqSchema]}
>
  <!-- 1. Split hero: photo left, teal panel right -->
  <section class="hero" aria-label="Introduction">
    <div class="container">
      <div class="hero__grid">
        <Photo
          image={vadaraImage('sterling-light-scenes-1.jpg')}
          alt="Kitchen with Vadara Sterling Light quartz worktops and island"
          credit="Vadara Sterling Light. Supplier photo."
          caption="Finished kitchen, one of our own installs"
          loading="eager"
          sizes="(min-width: 56rem) 60vw, 100vw"
          widths={[640, 1000, 1400, 1800]}
          class="hero__photo"
        />
        <div class="hero__panel">
          <span class="hero__kicker">Supply and fit, direct</span>
          <h1>Worktops fitted by the people the kitchen retailers use</h1>
          <p>Quartz, granite and ultra-compact. Templated, made and installed across Cheshire, Manchester and North Wales.</p>
          <a class="btn" href="#enquire">Get a quote</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. Short intro -->
  <section class="band">
    <div class="container">
      <div class="intro">
        <h2>A different way to buy worktops</h2>
        <p>
          We are the templaters and fitters the national kitchen retailers send to your house. For
          years the customer has been the retailer, not you. This is us doing the same job direct:
          same crews, same suppliers, same process, without the showroom in the middle.
        </p>
      </div>
    </div>
  </section>

  <!-- 3. Teal strip -->
  <div class="promo">
    <div class="container promo__inner">
      <p>Samples brought to your kitchen, not a showroom. Quote from a plan, no visit needed.</p>
      {hasPhone && <a class="btn btn--ghost" href={`tel:${site.contact.phoneE164}`}>Call {site.contact.phoneDisplay}</a>}
    </div>
  </div>

  <!-- 4. Swatch grid -->
  <section class="band">
    <div class="container">
      <div class="band__head">
        <h2>Popular surfaces</h2>
        <a class="btn btn--ghost" href="/colours">All colours</a>
      </div>
      <ul class="swatches">
        {
          swatches.map((s) => (
            <li class="swatch">
              <a href={s.href}>
                {s.image ? (
                  <Image src={s.image} alt={`${s.brand} ${s.name} worktop sample`} widths={[300, 600]} sizes="(min-width: 60rem) 20vw, 50vw" loading="lazy" class="swatch__img" />
                ) : (
                  <Placeholder caption={`${s.name} sample`} ratio="1 / 1" class="ph--small" />
                )}
                <span class="swatch__brand">{s.brand}</span>
                <span class="swatch__name">{s.name}</span>
                <span class="swatch__band">{s.costBand} <span class="muted">relative cost</span></span>
              </a>
            </li>
          ))
        }
      </ul>
      <p class="muted small">Slab photographs by Vadara. We fit other quartz brands too; if you have seen a colour elsewhere, ask.</p>
    </div>
  </section>

  <!-- 5. Blush split panel -->
  <section class="band band--tight">
    <div class="container">
      <div class="panel panel--sand">
        <div class="panel__text">
          <h2>Not sure which colour?</h2>
          <p>We narrow it down with you on the phone, then bring full-size samples to the template visit so you see them in your own light.</p>
          <a class="btn" href="/contact#enquire">Ask about samples</a>
        </div>
        <Photo
          image={vadaraImage('aurum-scenes-1.jpg')}
          alt="Kitchen island in Vadara Aurum quartz with gold and grey veining"
          credit="Vadara Aurum. Supplier photo."
          caption="Samples laid out on a fitted kitchen"
          sizes="(min-width: 56rem) 50vw, 100vw"
          class="panel__photo"
        />
      </div>
    </div>
  </section>

  <!-- 6. Four features with photos -->
  <section class="band">
    <div class="container">
      <span class="eyebrow">What makes us different</span>
      <h2>Discover Cheshire Stoneworks</h2>
      <ul class="features">
        <li>
          <Placeholder caption="Templating equipment in use" ratio="4 / 3" class="ph--small" />
          <h3>Templated, not measured</h3>
          <p>A digital template of the fitted units. Out-of-square walls are captured, not guessed.</p>
        </li>
        <li>
          <Placeholder caption="Fitters on a retail install" ratio="4 / 3" class="ph--small" />
          <h3>The retailers' own crews</h3>
          <p>The same two install teams and four templaters that work for the national kitchen brands.</p>
        </li>
        <li>
          <Placeholder caption="Resin join being polished" ratio="4 / 3" class="ph--small" />
          <h3>Joins planned before cutting</h3>
          <p>Where every join and cut-out goes is agreed with you at the template visit.</p>
        </li>
        <li>
          <Placeholder caption="Van outside a house in Cheshire" ratio="4 / 3" class="ph--small" />
          <h3>Local, from Lymm</h3>
          <p>About {site.coverageRadiusMiles} miles across Cheshire, Manchester, Merseyside and North Wales.</p>
        </li>
      </ul>
    </div>
  </section>

  <!-- 7. Comparison table -->
  <section class="band band--alt">
    <div class="container">
      <div class="band__head">
        <div>
          <span class="eyebrow">How the materials compare</span>
          <h2>Not all worktops are made equal</h2>
        </div>
        <a class="btn btn--ghost" href="/materials">Full comparison</a>
      </div>
      <div class="table-wrap">
        <table class="compare">
          <caption class="sr-only">Quick comparison of quartz, granite and ultra-compact worktops</caption>
          <thead>
            <tr>
              <th scope="col"></th>
              {materials.map((m) => <th scope="col">{m.name.replace(' (sintered)', '')}</th>)}
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Relative cost</th>
              {materials.map((m) => <td>{m.costBand}</td>)}
            </tr>
            {compareRows.map((row) => (
              <tr>
                <th scope="row">{row.label}</th>
                {materials.map((m) => {
                  const s = m.scores[row.key];
                  return <td class:list={['score', `score--${s}`]}>{ratingWords[s]}</td>;
                })}
              </tr>
            ))}
            <tr>
              <th scope="row">Needs sealing</th>
              <td>No</td>
              <td>Yes</td>
              <td>No</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>
  </section>

  <!-- 8. How it works, four steps with photos -->
  <section class="band">
    <div class="container">
      <div class="band__head">
        <div>
          <span class="eyebrow">How to buy</span>
          <h2>From plan to fitted in four steps</h2>
        </div>
        <a class="btn btn--ghost" href="/how-it-works">What we need from you</a>
      </div>
      <ol class="how">
        <li>
          <Placeholder caption="Kitchen plan on a table" ratio="4 / 3" class="ph--small" />
          <span class="how__n">Step 1</span>
          <h3>Send the plan</h3>
          <p>A photo of the plan or a sketch with sizes. We reply with an indicative price.</p>
        </li>
        <li>
          <Placeholder caption="Templater at work" ratio="4 / 3" class="ph--small" />
          <span class="how__n">Step 2</span>
          <h3>Template</h3>
          <p>Once the units are fitted and the sink and hob are on site. About an hour.</p>
        </li>
        <li>
          <Placeholder caption="Slab on the saw" ratio="4 / 3" class="ph--small" />
          <span class="how__n">Step 3</span>
          <h3>Fabrication</h3>
          <p>Cut and polished to the template. Typically {site.leadTimes.templateToInstall}.</p>
        </li>
        <li>
          <Placeholder caption="Fitters setting the worktop" ratio="4 / 3" class="ph--small" />
          <span class="how__n">Step 4</span>
          <h3>Install</h3>
          <p>Fitted, joined, sealed and cleaned. Most kitchens in half a day.</p>
        </li>
      </ol>
    </div>
  </section>

  <!-- 9. Reviews -->
  <section class="band band--alt">
    <div class="container">
      <div class="band__head">
        <div>
          <span class="eyebrow">What our customers say</span>
          <h2>What customers say about the fit</h2>
        </div>
        {reviewLinks.length > 0 && <a class="btn btn--ghost" href={reviewLinks[0].url} rel="noopener">View our reviews</a>}
      </div>
      {
        reviewLinks.length ? (
          <p>
            Read our reviews on{' '}
            {reviewLinks.map((r, i) => (
              <>
                <a href={r.url} rel="noopener">{r.label}</a>
                {i < reviewLinks.length - 1 ? ', ' : ''}
              </>
            ))}
            .
          </p>
        ) : (
          <div class="reviews-ph">
            {[1, 2, 3, 4].map(() => (
              <div class="reviews-ph__card" aria-hidden="true">
                <span class="reviews-ph__stars">Review to follow</span>
                <span class="reviews-ph__line" />
                <span class="reviews-ph__line reviews-ph__line--short" />
              </div>
            ))}
            <p class="muted reviews-ph__note">
              [TODO: reviews. We do not publish invented testimonials. Add your Google, Checkatrade or Trustpilot links in
              src/data/site.ts and this block becomes real review links. Real quotes can be added here once you have permission.]
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 10. Dark split: the difference -->
  <section class="band band--tight">
    <div class="container">
      <div class="panel panel--dark">
        <Placeholder caption="Templating a fitted kitchen" class="panel__photo ph--square" />
        <div class="panel__text">
          <span class="eyebrow">Why us</span>
          <h2>The template is the job</h2>
          <p>
            Most bad worktop installs go wrong before the stone is cut: a join in the wrong place, a
            hob cut-out ten millimetres out, a wall that was never square. We template with the same
            equipment and process we use for the national retailers, every working day. It is the part
            of the job you cannot see in a showroom.
          </p>
          <a class="btn btn--outline-white" href="/about">About the team</a>
        </div>
      </div>
    </div>
  </section>

  <!-- 11. Recent installs -->
  <section class="band">
    <div class="container">
      <div class="band__head">
        <div>
          <span class="eyebrow">Recent work</span>
          <h2>Kitchens we have fitted</h2>
        </div>
        <a class="btn btn--ghost" href="/gallery">See the gallery</a>
      </div>
      <ul class="recent">
        {
          recent.map((g) => (
            <li>
              {g.image ? (
                <Image src={g.image} alt={g.alt} widths={[400, 800]} sizes="(min-width: 60rem) 25vw, 50vw" loading="lazy" class="recent__img" />
              ) : (
                <Placeholder caption={g.title} ratio="4 / 3" class="ph--small" />
              )}
              <h3>{g.title}</h3>
              <p class="muted">{materialLabels[g.material]} · {g.location}</p>
            </li>
          ))
        }
      </ul>
      <p class="muted small">Every photo on this site is our own work, shown with the customer's permission. No stock imagery.</p>
    </div>
  </section>

  <!-- 12. Dark CTA -->
  <section class="band band--tight">
    <div class="container">
      <div class="panel panel--dark panel--cta">
        <div class="panel__text">
          <h2>Your local stone fitters</h2>
          <p>
            Lymm, Cheshire. {areaGroups.map((g) => g.name).join(', ')}. Send the plan and we will
            come back with a price and the next available survey date.
          </p>
          <a class="btn btn--white" href="#enquire">Get a quote</a>
        </div>
        <Photo
          image={vadaraImage('phoenix-sky-scenes-1.jpg')}
          alt="Kitchen with Vadara Phoenix Sky quartz worktops"
          credit="Vadara Phoenix Sky. Supplier photo."
          caption="Fitted worktop close-up"
          sizes="(min-width: 56rem) 40vw, 100vw"
          class="panel__photo"
        />
      </div>
    </div>
  </section>

  <!-- 13. FAQ -->
  <section class="band">
    <div class="container">
      <Faq items={homeFaqs} />
    </div>
  </section>

  <!-- 14. Enquiry -->
  <section class="band band--alt">
    <div class="container">
      <EnquiryForm />
    </div>
  </section>
</Layout>

<style>
  .band {
    padding-block: clamp(2.25rem, 4vw, 3.5rem);
  }
  .band--tight {
    padding-block: clamp(1rem, 2vw, 1.5rem);
  }
  .band--alt {
    background: var(--stone-50);
  }
  .band__head {
    display: flex;
    justify-content: space-between;
    align-items: end;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    margin-bottom: 1.5rem;
  }
  .band__head h2 {
    margin-bottom: 0;
  }
  .band__head .btn {
    min-height: 2.75rem;
    padding: 0.45rem 1.1rem;
    font-size: 0.95rem;
  }
  .small {
    font-size: 0.9rem;
  }

  /* Hero */
  .hero {
    padding-top: clamp(0.75rem, 2vw, 1.25rem);
  }
  .hero__grid {
    display: grid;
    gap: 0.75rem;
    grid-template-columns: 1fr;
  }
  .hero__photo {
    aspect-ratio: 16 / 9;
  }
  .hero__panel {
    background: var(--stone-100);
    color: var(--text);
    padding: clamp(1.5rem, 3vw, 2.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 0.5rem;
  }
  .hero__kicker {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--teal-dark);
    font-weight: 700;
  }
  .hero__panel h1 {
    font-size: clamp(1.75rem, 1.2rem + 1.8vw, 2.6rem);
    letter-spacing: -0.02em;
    margin-bottom: 0.25rem;
    font-weight: 500;
  }
  .hero__panel p {
    color: var(--muted);
    margin-bottom: 1rem;
  }
  .hero__panel .btn {
    align-self: flex-start;
  }
  @media (min-width: 56rem) {
    .hero__grid {
      grid-template-columns: 3fr 2fr;
      min-height: 30rem;
    }
    .hero__photo {
      aspect-ratio: auto;
      height: 100%;
    }
  }

  .intro {
    max-width: 44rem;
  }

  .promo {
    background: var(--teal-light);
    color: var(--teal-dark);
  }
  .promo__inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem 2rem;
    flex-wrap: wrap;
    padding-block: 1rem;
  }
  .promo p {
    font-weight: 600;
    font-size: 1.1rem;
    margin: 0;
  }
  .promo .btn {
    min-height: 2.6rem;
    padding: 0.4rem 1rem;
    font-size: 0.95rem;
  }

  /* Swatches */
  .swatches {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 10.5rem), 1fr));
  }
  .swatch__img {
    width: 100%;
    aspect-ratio: 1;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }
  .swatch a {
    display: block;
    text-decoration: none;
    color: inherit;
  }
  .swatch a:hover .swatch__name {
    color: var(--teal-dark);
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .swatch span {
    display: block;
  }
  .swatch__brand {
    margin-top: 0.6rem;
    font-size: 0.75rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .swatch__name {
    font-weight: 700;
    font-size: 0.95rem;
  }
  .swatch__band {
    font-size: 0.85rem;
    color: var(--teal-dark);
    font-weight: 700;
  }
  .swatch__band .muted {
    font-weight: 400;
  }

  /* Split panels */
  .panel {
    display: grid;
    grid-template-columns: 1fr;
    overflow: hidden;
    border-radius: var(--radius);
  }
  .panel--sand {
    background: var(--stone-100);
  }
  .panel--dark {
    background: var(--ink);
    color: #fff;
  }
  .panel--dark .eyebrow {
    color: #d9cfc0;
  }
  .panel--dark p {
    color: #e6e0d6;
  }
  .panel--dark h2 {
    font-weight: 500;
  }
  .panel__text {
    padding: clamp(1.5rem, 4vw, 3.5rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: flex-start;
    gap: 0.25rem;
  }
  .panel__text p {
    max-width: 44ch;
    margin-bottom: 1.25rem;
  }
  .panel__photo {
    aspect-ratio: 16 / 9;
    min-height: 14rem;
  }
  @media (min-width: 56rem) {
    .panel {
      grid-template-columns: 1fr 1fr;
    }
    .panel__photo {
      aspect-ratio: auto;
      height: 100%;
    }
    .panel--cta {
      grid-template-columns: 3fr 2fr;
    }
  }

  /* Features and steps */
  .features,
  .how,
  .recent {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 1.5rem 1.25rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .features h3,
  .how h3,
  .recent h3 {
    font-size: 1.05rem;
    margin: 0.85rem 0 0.3rem;
  }
  .features p,
  .how p,
  .recent p {
    font-size: 0.95rem;
    color: var(--muted);
  }
  .how__n {
    display: block;
    margin-top: 0.85rem;
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal-dark);
    font-weight: 700;
  }
  .how h3 {
    margin-top: 0.2rem;
  }
  .recent__img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--radius-sm);
  }

  /* Comparison */
  .compare th[scope='row'] {
    font-weight: 400;
    color: var(--text);
    width: 30%;
  }
  .compare thead th {
    font-size: 1.05rem;
  }
  .score--5,
  .score--4 {
    color: var(--teal-dark);
    font-weight: 700;
  }
  .score--1,
  .score--2 {
    color: var(--error);
  }

  /* Review placeholders */
  .reviews-ph {
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 14rem), 1fr));
  }
  .reviews-ph__card {
    background: #fff;
    border-radius: var(--radius-sm);
    padding: 1.25rem;
    display: grid;
    gap: 0.6rem;
    box-shadow: var(--shadow);
  }
  .reviews-ph__stars {
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .reviews-ph__line {
    height: 0.6rem;
    background: var(--stone-100);
    border-radius: 3px;
  }
  .reviews-ph__line--short {
    width: 60%;
  }
  .reviews-ph__note {
    grid-column: 1 / -1;
    font-size: 0.9rem;
  }
</style>
