# Copy to .env for local `npm run dev` / `npm run build`.
# Public URL of the site (used for canonical links, sitemap and structured data).
SITE_URL=https://worktops.example.co.uk

# Cloudflare Turnstile site key (public). The value below is Cloudflare's
# "always passes" test key. Replace with your real site key in production.
PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
